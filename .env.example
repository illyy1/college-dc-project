# Copy this file to .env (in the project root) and fill in the values.
# .env is in .gitignore and is never committed; this example holds no secrets.
# Everything here is optional: without it the dashboard still runs, it just
# posts nothing to GitHub and asks Gemini nothing.

# --- GitHub alerts: an issue for each new fault ---
# A GitHub personal access token, encrypted with Fernet, and the key used to
# encrypt it. To create both values (put your token in place of <your token>):
#   python -c "from cryptography.fernet import Fernet; k = Fernet.generate_key(); print('ENCRYPTION_KEY=' + k.decode()); print('GITHUB_TOKEN=' + Fernet(k).encrypt(b'<your token>').decode())"
GITHUB_TOKEN=<GitHub personal access token, encrypted with Fernet>
ENCRYPTION_KEY=<the Fernet key used to encrypt it>

# --- AI triage: Gemini judges each fault (priority, cause, repair time, steps) ---
# A Gemini API key from Google AI Studio (https://aistudio.google.com), as is.
GEMINI_API_KEY=<your key from Google AI Studio>
